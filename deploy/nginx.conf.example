# Single-origin reverse proxy for a VPS (TLS with certbot or Caddy is assumed; adjust paths and names).
# Browser -> https://astrohealth.example.com
#   /                 -> frontend (static build or the frontend container)
#   /api/, /socket.io -> Node backend  (127.0.0.1:4000)
#   /engine/          -> engine, GET-only, only the two routes the dashboards call
#
# With this layout build the frontend with:
#   VITE_API_URL=https://astrohealth.example.com
#   VITE_ENGINE_URL=https://astrohealth.example.com/engine
# and set FRONTEND_ORIGIN=https://astrohealth.example.com in the backend.

server {
    listen 443 ssl http2;
    server_name astrohealth.example.com;

    ssl_certificate     /etc/letsencrypt/live/astrohealth.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/astrohealth.example.com/privkey.pem;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Engine: read-only, only what the dashboards need. Everything else (simulation reset, demo controls) stays internal.
    location ~ ^/engine/(api/v1/astronauts|api/v1/live/ticks)$ {
        limit_except GET { deny all; }
        rewrite ^/engine/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }
    location /engine/ { return 404; }

    location / {
        root /var/www/astrohealth;          # contents of frontend/dist
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    server_name astrohealth.example.com;
    return 301 https://$host$request_uri;
}
