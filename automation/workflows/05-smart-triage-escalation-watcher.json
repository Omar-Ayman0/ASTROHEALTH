    },
    {
      "parameters": {
        "jsCode": "const escalations = Array.isArray($json.escalations) ? $json.escalations : [];\nreturn escalations.map((escalation) => ({ json: escalation }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        912
      ],
      "id": "c9817316-182a-4992-8749-1d83c73d74fa",
      "name": "Expand Due Escalations"
    },
    {
      "parameters": {
        "jsCode": "const stage = $json.stage ?? 'REMINDER_1';\nconst incidentId = $json.incident_id;\nconst escalationId = $json.escalation_id;\nconst notification = { title: stage === 'ESCALATED' ? 'Incident escalated' : 'Medical review reminder', message: `Incident ${incidentId} requires medical acknowledgement.`, severity: stage === 'ESCALATED' ? 'HIGH' : 'MEDIUM' };\nreturn [{ json: { ...$json, notification, request_id: `escalation-${escalationId}-${stage}` } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        912
      ],
      "id": "63c0be10-bb73-4c40-bea6-aff736f215cb",
