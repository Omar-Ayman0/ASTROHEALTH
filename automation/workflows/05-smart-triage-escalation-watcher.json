      "id": "caa3f8f6-6cd3-4a18-b8b7-9154f48b2e5b",
      "name": "Get Due Triage Jobs",
      "credentials": {
        "httpHeaderAuth": {
          "name": "ASTROHEALTH Backend Auth"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const payload = $json.body ?? $json.data ?? $json;\nconst jobs = Array.isArray(payload.jobs) ? payload.jobs : [];\nreturn jobs.map(job => ({ json: job }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4864,
