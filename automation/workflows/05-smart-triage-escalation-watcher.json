      "name": "Get Triage Context",
      "credentials": {
        "httpHeaderAuth": {
          "name": "ASTROHEALTH Backend Auth"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You create a concise ASTROHEALTH triage brief for a human medical officer. Use only evidence in the supplied incident context. Do not diagnose, prescribe treatment, assign clinical risk, or invent facts. Preserve engine severity and findings. Every evidence_refs value MUST be copied exactly from the supplied available evidence_refs list; never create a new reference. Return only the configured JSON. confidence must be a number from 0 to 1. Include the limitation: 'AI-generated summary for human medical review; not a diagnosis.'"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        5280,
        1040
      ],
      "id": "d882ec8c-ba21-433c-acfc-868a238e0642",
      "name": "Generate AI Triage Brief",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite",
        "options": {
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        5280,
        1184
      ],
      "id": "763ad4d8-a033-4c0c-833a-1df6bde0f9d0",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"summary\": { \"type\": \"string\" },\n    \"findings\": { \"type\": \"array\", \"maxItems\": 4, \"items\": { \"type\": \"string\" } },\n    \"evidence_refs\": { \"type\": \"array\", \"maxItems\": 6, \"items\": { \"type\": \"string\" } },\n    \"suggested_checks\": { \"type\": \"array\", \"maxItems\": 3, \"items\": { \"type\": \"string\" } },\n    \"confidence\": { \"type\": \"number\", \"minimum\": 0, \"maximum\": 1 },\n    \"limitations\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n  },\n  \"required\": [\"summary\", \"findings\", \"evidence_refs\", \"suggested_checks\", \"confidence\", \"limitations\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        5488,
        1184
      ],
      "id": "85088593-e418-43c7-b87b-9dc679cf2b69",
      "name": "Triage Brief Output Schema"
    },
    {
      "parameters": {
        "jsCode": "const response = $('Get Triage Context').item.json;\nconst context = response.context ?? {};\nconst incident = context.incident ?? {};\nconst incidentId = incident.incident_id;\nconst raw = $json.output ?? $json;\nconst valid = raw && typeof raw.summary === 'string' && Array.isArray(raw.findings) && Array.isArray(raw.evidence_refs) && Array.isArray(raw.suggested_checks) && typeof raw.confidence === 'number' && raw.confidence >= 0 && raw.confidence <= 1 && Array.isArray(raw.limitations);\nconst availableRefs = Array.isArray(context.evidence_refs) ? context.evidence_refs : [];\nconst fallback = {\n  summary: `Incident ${incidentId} requires human medical review.`,\n  findings: [\n    `Engine severity: ${incident.severity ?? 'UNKNOWN'}.`,\n    `Astronaut: ${incident.astronaut_id ?? 'UNKNOWN'}.`\n  ],\n  evidence_refs: availableRefs.slice(0, 2),\n  suggested_checks: ['Review the available engine report and event evidence.'],\n  confidence: 0,\n  limitations: ['AI briefing was unavailable; this fallback is derived from stored incident metadata.', 'Human medical review required.'],\n  status: 'FALLBACK'\n};\nconst brief = valid ? raw : fallback;\nreturn [{ json: { incident_id: incidentId, request_id: `triage-${incidentId}-${Date.now()}`, brief } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5600,
        1040
      ],
      "id": "c998a620-8d8b-430c-ac62-111c4e387eb5",
      "name": "Validate Brief or Build Fallback"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://host.docker.internal:4000/api/v1/incidents/' + $json.incident_id + '/triage-brief' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ request_id: $json.request_id, ...$json.brief }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
