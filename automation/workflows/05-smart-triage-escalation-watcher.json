      "credentials": {
        "httpHeaderAuth": {
          "name": "ASTROHEALTH Backend Auth"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst payload = typeof $json.data === 'string'\n  ? JSON.parse($json.data)\n  : ($json.data ?? $json);\n\nconst jobs = Array.isArray(payload.jobs)\n  ? payload.jobs\n  : [];\n\nreturn jobs.map((job) => ({\n  json: job\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        400
      ],
      "id": "c5e3a1e4-bd15-4a10-818a-67b71e0fc54a",
