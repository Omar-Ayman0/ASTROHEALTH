              "leftValue": "={{ (() => {\n  const b = $('Webhook').first().json.body;\n  const e = b?.event;\n\n  const id = v =>\n    typeof v === 'string' &&\n    v.trim().length > 0 &&\n    v === v.trim();\n\n  const createdAt =\n    e?.created_at ||\n    b?.created_at ||\n    e?.timestamp ||\n    b?.timestamp;\n\n  const needsHumanReview =\n    e?.needs_human_review ??\n    b?.needs_human_review;\n\n  return !!(\n    b &&\n    typeof b === 'object' &&\n    !Array.isArray(b) &&\n    e &&\n    typeof e === 'object' &&\n    !Array.isArray(e) &&\n\n    b.schema_version === '1.0' &&\n    b.event_type === 'HEALTH_REVIEW_REQUIRED' &&\n\n    id(b.event_id) &&\n    id(b.astronaut_id) &&\n    id(b.emission_id) &&\n    id(b.engine_instance_id) &&\n\n    Number.isInteger(b.run) &&\n    b.run >= 1 &&\n\n    Number.isInteger(b.sequence) &&\n    b.sequence >= 1 &&\n\n    typeof createdAt === 'string' &&\n    Number.isFinite(Date.parse(createdAt)) &&\n\n    typeof b.emitted_at === 'string' &&\n    Number.isFinite(Date.parse(b.emitted_at)) &&\n\n    e.event_id === b.event_id &&\n    e.astronaut_id === b.astronaut_id &&\n\n    needsHumanReview === true &&\n\n    typeof e.anomaly_score === 'number' &&\n    Number.isFinite(e.anomaly_score) &&\n    e.anomaly_score >= 0 &&\n    e.anomaly_score <= 1 &&\n\n    typeof e.severity === 'string' &&\n    e.severity.trim().length > 0 &&\n\n    typeof e.explanation === 'string' &&\n    e.explanation.trim().length > 0\n  );\n})() }}",
